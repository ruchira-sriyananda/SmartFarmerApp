<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="0dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <!-- User Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivUserImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:src="@drawable/thumb_show_fotor_bg_remover_20260709171323"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="#F0F0F0"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="User Name"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPostDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="2 hours ago"
                android:textColor="@color/primary_blue"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnPostMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_more"
                android:visibility="gone"
                app:tint="@color/gray" />
        </LinearLayout>

        <!-- Post Content -->
        <TextView
            android:id="@+id/tvPostContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:paddingHorizontal="16dp"
            android:text="This is the post content area where users can share their thoughts."
            android:textColor="@color/black"
            android:textSize="15sp" />

        <!-- Post Images -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPostImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <ImageView
                android:id="@+id/ivPostImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:maxHeight="400dp"
                android:scaleType="fitCenter"
                android:src="@drawable/thumb_show_fotor_bg_remover_20260709171323"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvImageError"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#F5F5F5"
                android:gravity="center"
                android:text="Image Not Available"
                android:textColor="@color/gray"
                android:textSize="14sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnSaveImage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#80000000"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_save"
                app:tint="@color/white"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Interaction Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLikesCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 Likes"
                    android:textColor="@color/gray"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/tvCommentsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Comments"
                    android:textColor="@color/gray"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="4dp"/>
            </LinearLayout>

            <!-- Quick Add Comment Section -->
            <LinearLayout
                android:id="@+id/layoutQuickComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivCommentUserSmall"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/thumb_show_fotor_bg_remover_20260709171323"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="#EEEEEE"
                    app:strokeWidth="1dp" />

                <EditText
                    android:id="@+id/etQuickComment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_comment_input"
                    android:hint="@string/write_comment_hint"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/gray"
                    android:textColorHint="@color/gray"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnSendQuickComment"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="@color/ocean_blue" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLike"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Like"
                    android:textAllCaps="false"
                    android:textColor="@color/gray"
                    app:icon="@drawable/ic_thumb_up"
                    app:iconPadding="4dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/gray" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnComment"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/comment"
                    android:textAllCaps="false"
                    android:textColor="@color/gray"
                    app:icon="@android:drawable/stat_notify_chat"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/gray" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Share"
                    android:textAllCaps="false"
                    android:textColor="@color/gray"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconPadding="8dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/gray" />
            </LinearLayout>

            <!-- Comments Section -->
            <LinearLayout
                android:id="@+id/layoutComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="8dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="#F0F2F5" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
